# ---------------------------------------------------------------------------
# OTP verification server configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your credentials:
#     cp .env.example .env
#
# With no Twilio credentials the server starts in DEMO MODE: it generates a
# real 6-digit code, prints it to the console and returns it to the app, so
# the full send -> verify flow works without a paid SMS account.
# ---------------------------------------------------------------------------

PORT=4000

# Which provider to use: "twilio", "demo", or leave blank to auto-detect
# (Twilio when the three credentials below are set, otherwise demo).
OTP_PROVIDER=

# --- Twilio Verify -------------------------------------------------------
# 1. Sign up at https://www.twilio.com/try-twilio
# 2. Account SID + Auth Token are on the Twilio Console dashboard.
# 3. Create a Verify Service: Console -> Verify -> Services -> Create.
#    Copy its SID (starts with "VA").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
