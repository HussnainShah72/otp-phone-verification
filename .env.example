# ---------------------------------------------------------------------------
# Expo app configuration (optional)
# ---------------------------------------------------------------------------
# Copy to `.env` only if you need to override the backend URL:
#     cp .env.example .env
#
# By default the app finds the backend automatically:
#   * Expo Go on a phone  -> http://<your-pc-LAN-ip>:4000 (taken from the Expo dev host)
#   * Android emulator    -> http://10.0.2.2:4000
#   * iOS simulator / web -> http://localhost:4000
#
# Set this when the server runs somewhere else (a tunnel or a deployed host).
# Must be reachable from the phone, and must include the scheme and port.
# EXPO_PUBLIC_API_URL=https://your-server.example.com
